# Customer/demo adapters remain local-only. Formal staff auth is server-only.
NEXT_PUBLIC_APP_MODE=mock
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Taipei

# Configure exactly one HTTPS origin when exercising formal auth. Never commit values.
DUM_PUBLIC_BASE_URL=
# DUM_STAGING_BASE_URL=
DUM_DATABASE_PATH=
BETTER_AUTH_SECRET=

# Single-host backup settings. The recipient is an Owner public key; keep its
# private key off this PC. Never commit real values.
DUM_BACKUP_TARGET=
DUM_GPG_PATH=
DUM_GPG_RECIPIENT=

# Public collection-notice contact URI: strict https:, mailto:, or E.164 tel:.
# Staging must use an explicitly fictional .invalid mail or HTTPS URI.
DUM_CUSTOMER_DATA_CONTACT=

# Explicit one-account provisioning input; migration/startup never auto-seeds auth data.
DUM_STAFF_USERNAME=
DUM_STAFF_PASSWORD=
